PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/encounters

# "mock" is free, local and deterministic. Use "openai" with a real key for actual summaries.
SUMMARY_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SUMMARY_TIMEOUT_MS=15000
SLA_SECONDS=10
MAX_SUMMARY_ATTEMPTS=8
RETRY_BASE_MS=2000
RETRY_MAX_MS=300000
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=15000
CIRCUIT_MAX_COOLDOWN_MS=300000
WORKER_POLL_MS=500
